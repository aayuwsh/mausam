# Server-only configuration. Do not prefix secrets with VITE_ and expose them in browser bundles.
VITE_API_URL=http://127.0.0.1:8000/api/v1
# Public Supabase browser configuration (phone provider and redirect URLs must be set in Supabase Auth).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for normalized profile/database sync. Supabase Auth URL/key alone cannot connect PostgreSQL.
# Use the existing Supabase project's direct or session-pooler PostgreSQL URI; never commit the password.
DATABASE_URL=
# Optional local Compose override. The fallback in docker-compose.yml is local-only.
MAUSAM_DB_PASSWORD=mausam_local_dev
MAUSAM_DATABASE_URL=
ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5180
COPERNICUS_CDS_URL=https://cds.climate.copernicus.eu/api
COPERNICUS_CDS_KEY=
OPEN_METEO_SEASONAL_URL=https://seasonal-api.open-meteo.com/v1/seasonal
# Configure Open-Meteo commercial endpoint/licence if the deployment is commercial.
OPEN_METEO_CUSTOMER_URL=
ENABLE_OPEN_METEO_INGESTION=false
ENABLE_PUBLIC_CLIMATE_INGESTION=false
# Optional separate direct-SMS adapter; otherwise configure a supported provider in Supabase Auth.
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=
SMS_PROVIDER_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
ENABLE_NOTIFICATION_DISPATCH=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
REDIS_URL=redis://127.0.0.1:6379/0
# Optional server-side farming assistant. Never use a VITE_ prefix for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
SESSION_JWT_AUDIENCE=authenticated
